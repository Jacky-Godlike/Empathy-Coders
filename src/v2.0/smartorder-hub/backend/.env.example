# SmartOrder Hub local configuration.
#
# Copy this file to backend/.env before running the API. Never commit the real
# .env file or put platform access tokens in the frontend.
#
# On Replit, set these values in Tools -> Secrets instead of creating .env.

# ---------------------------------------------------------------------------
# Business policy (optional; defaults shown)
# ---------------------------------------------------------------------------
# SMARTORDERHUB_MIN_MARGIN=0.15
# SMARTORDERHUB_WARN_MARGIN=0.20
# SMARTORDERHUB_HIGH_VALUE_THRESHOLD=1000
# SMARTORDERHUB_LEAD_TIME_BUFFER_DAYS=1
# SMARTORDERHUB_MIN_CONFIDENCE=0.80
# SMARTORDERHUB_RISK_MEDIUM_THRESHOLD=25
# SMARTORDERHUB_RISK_HIGH_THRESHOLD=50
# SMARTORDERHUB_RISK_CRITICAL_THRESHOLD=75
# SMARTORDERHUB_INTAKE_MODE=rules

# ---------------------------------------------------------------------------
# AI extraction (optional)
# Without a key, SmartOrder Hub uses the deterministic rule extractor.
# ---------------------------------------------------------------------------
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Any OpenAI-compatible chat-completions endpoint:
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Channel collection
# Shared secret required in the X-Webhook-Token header. Leave empty only for
# the local synthetic demo. Generate a long random value in production.
# ---------------------------------------------------------------------------
SMARTORDERHUB_CHANNEL_WEBHOOK_TOKEN=

# Optional storage paths. The defaults are backend/app/data and frontend/dist.
# SMARTORDERHUB_DATA_DIR=
# SMARTORDERHUB_FRONTEND_DIST=
